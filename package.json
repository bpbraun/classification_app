{
  "name": "classification-app",
  "version": "0.1.0",
  "description": "Turns a security classification guide into machine-readable rules and checks cited markings. Demo on ISOO public training material.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "extract": "tsx src/pipeline/cli/extract.ts",
    "propose": "tsx src/pipeline/cli/propose.ts",
    "build-data": "tsx src/pipeline/cli/build-data.ts",
    "verify-release": "tsx src/pipeline/cli/verify-release.ts"
  },
  "author": "Braun Applied Intelligence",
  "license": "MIT",
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "1.5.0",
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "pdfjs-dist": "6.5.438",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "overrides": {
    "minimatch": "11.0.4"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
